{
  "name": "slock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --watch packages/server/src/index.ts --dev",
    "build": "bun run packages/server/src/index.ts --build",
    "start": "bun run packages/server/src/index.ts",
    "check": "biome check . --write && bun scripts/check-claude-md.mjs",
    "format": "biome format . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "jsdom": "^30.1.0",
    "typescript": "~6.0.2"
  }
}
