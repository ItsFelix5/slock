{
  "name": "slock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examplePlugin"
  ],
  "scripts": {
    "dev": "bun run --watch packages/server/src/dev.ts",
    "plugin": "bun packages/installer/src/cli.ts",
    "start": "bun instance/server.js",
    "relay": "bun run packages/relay/src/index.ts",
    "test": "bun test --conditions browser --conditions development --timeout 30000",
    "check": "biome check . --write && tsc -b && bun scripts/checkPlugins.ts && bun scripts/checkPackages.ts && bun scripts/checkSource.ts",
    "format": "biome format . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@slock/core": "workspace:*",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.2"
  }
}
