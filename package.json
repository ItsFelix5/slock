{
  "name": "slock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter slock-web dev",
    "server": "bun run --filter @slock/server start",
    "build": "tsc -b && bun run --filter slock-web build",
    "start": "bun run --filter slock-web build && bun run --filter @slock/server start",
    "preview": "bun run --filter slock-web preview",
    "check": "biome check . && bun run build",
    "format": "biome check . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "typescript": "~6.0.2"
  }
}
