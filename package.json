{
  "name": "slock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examplePlugin"
  ],
  "scripts": {
    "dev": "bun run --watch packages/installer/src/devServer.ts",
    "plugin": "bun packages/installer/src/cli.ts",
    "central": "bun run packages/central/src/index.ts",
    "test": "bun test --conditions browser --conditions development --timeout 30000",
    "check": "biome check . --write && tsc -b && bun scripts/checkPlugins.ts && bun scripts/checkPackages.ts && bun scripts/checkSource.ts",
    "format": "biome format . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@slock/blockkit": "workspace:*",
    "@slock/core": "workspace:*",
    "@slock/installer": "workspace:*",
    "@slock/plugins": "workspace:*",
    "@slock/slack": "workspace:*",
    "@slock/types": "workspace:*",
    "@slock/ui": "workspace:*",
    "@solidjs/web": "2.0.3",
    "@types/node": "^24.13.2",
    "bun-types": "^1.3.14",
    "happy-dom": "^21.0.4",
    "solid-js": "2.0.3",
    "typescript": "~6.0.2"
  }
}
